{
  "name": "ucapsa-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~57.0.23",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.11",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.20",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-routes.mjs",
    "check:integrity": "node scripts/check-source-integrity.mjs",
    "check:ui-quality": "node scripts/check-ui-quality.mjs",
    "check:info-hierarchy": "node scripts/check-info-hierarchy.mjs",
    "check:navigation-smoke": "node scripts/check-navigation-smoke.mjs",
    "check:multi-dog": "node scripts/check-multi-dog.mjs",
    "check:offline-roundtrip": "node scripts/check-offline-roundtrip.mjs",
    "check:rango-1-foundation": "node scripts/check-rango-1-foundation.mjs",
    "check:rango-1-constancy": "node scripts/check-rango-1-constancy.mjs",
    "check:rango-1-seasons": "node scripts/check-rango-1-seasons.mjs",
    "check:rango-1-closed-freeze": "node scripts/check-rango-1-closed-freeze.mjs",
    "check:ci-policy": "node scripts/check-ci-policy.mjs",
    "verify": "npm run typecheck && npm run check:routes && npm run check:integrity && npm run check:ui-quality && npm run check:info-hierarchy && npm run check:navigation-smoke && npm run check:multi-dog && npm run check:offline-roundtrip && npm run check:rango-1-foundation && npm run check:rango-1-constancy && npm run check:rango-1-seasons && npm run check:rango-1-closed-freeze",
    "audit:report": "npm audit --omit=dev",
    "check:release": "node scripts/check-release.mjs",
    "verify:release": "npm run verify && npm run check:release && npm run check:nanoid-security && npm run check:ci-policy",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "check:build-env": "node scripts/check-build-env.mjs",
    "eas-build-post-install": "npm run verify:release && npm run check:build-env",
    "check:nanoid-security": "node scripts/check-nanoid-security.mjs"
  },
  "private": true,
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "nanoid@>=4.0.0 <=5.1.10": "5.1.16"
  }
}
